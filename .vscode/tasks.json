{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Brain Match",
      "type": "process",
      "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
      "args": [
        "-std=c99",
        "-O2",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-mwindows",
        "${workspaceFolder}\\main.c",
        "${workspaceFolder}\\game.c",
        "${workspaceFolder}\\menu.c",
        "${workspaceFolder}\\score.c",
        "-o",
        "${workspaceFolder}\\brain_match_gui.exe",
        "-lraylib",
        "-lopengl32",
        "-lgdi32",
        "-lwinmm",
        "-lm"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
